<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppTrilhaAprendizagem.Views.CriarConteudoPage"
             Title="Criar Conteúdo">

    <ScrollView>

        <VerticalStackLayout Padding="20"
                             Spacing="12">

            <Label Text="🎨 NOVO DESAFIO"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <Label Text="Trilha de Destino"/>

            <Picker x:Name="pickerTrilha">

                <Picker.Items>
                    <x:String>Trilha dos Números</x:String>
                    <x:String>Trilha das Quantidades</x:String>
                    <x:String>Trilha das Cores</x:String>
                    <x:String>Trilha das Formas</x:String>
                </Picker.Items>

            </Picker>

            <Label Text="Pergunta"/>

            <Entry x:Name="entryPergunta"
                   Placeholder="Digite a pergunta"/>

            <Label Text="Alternativa A"/>

            <Entry x:Name="entryAltA"
                   Placeholder="Alternativa A"/>

            <Label Text="Alternativa B"/>

            <Entry x:Name="entryAltB"
                   Placeholder="Alternativa B"/>

            <Label Text="Alternativa C"/>

            <Entry x:Name="entryAltC"
                   Placeholder="Alternativa C"/>

            <Label Text="Resposta Correta"/>

            <Picker x:Name="pickerCorreta">

                <Picker.Items>
                    <x:String>A</x:String>
                    <x:String>B</x:String>
                    <x:String>C</x:String>
                </Picker.Items>

            </Picker>

            <Button Text="✅ Salvar Conteúdo"
                    BackgroundColor="#0078D7"
                    TextColor="White"
                    Clicked="OnSalvarConteudoClicked"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>